                  "robots.read",
                  "robots.create",
                  "users.read",
                  "users.manage",
                  "channels.read",
                  "channels.manage",
                  "billing.read",
                  "campaigns.read",
                  "campaigns.create",
                  "templates.read",
                  "templates.manage"
