                "guia-importar-contatos",
                "robo-de-atendimento",
                "usuario-acesso",
                "reconectar-canal-qr",
                "campanhas",
                "permissoes-departamentos",
                "arquivos",
                "crm"
              ]
            },
            "stepId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "mode": {
              "type": "string",
              "enum": [
                "real",
                "treino"
              ]
            },
            "pendingChoiceId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
            },
            "pendingChoice": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
            },
            "choiceId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
            },
            "stateToken": {
              "type": "string",
              "maxLength": 128
            }
          },
          "required": [
            "guideId",
            "stepId",
            "version",
            "mode"
          ],
          "additionalProperties": false
        }
