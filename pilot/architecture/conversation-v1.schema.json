              }
            },
            "plan": {
              "type": "string",
              "enum": [
                "trial",
                "active",
                "expired",
                "limited",
                "unknown"
              ]
            },
            "channels": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "whatsapp",
                      "official_api",
                      "coexistence"
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "connected",
                      "disconnected",
                      "qr_pending",
                      "blocked",
                      "syncing",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "state"
                ],
                "additionalProperties": false
              }
            },
            "credit": {
              "type": "string",
              "enum": [
                "available",
                "low",
                "empty",
                "unknown"
              ]
            },
            "templates": {
              "type": "string",
              "enum": [
                "none",
                "pending",
                "approved",
                "rejected",
                "unknown"
              ]
            },
            "incidents": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "channel_outage",
                  "message_delivery",
                  "billing",
                  "robot",
