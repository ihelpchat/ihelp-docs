{
  "schemaVersion": 1,
  "schemas": {
    "GuideV1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "guideId": {
          "type": "string",
          "enum": [
            "guia-importar-contatos",
            "robo-de-atendimento",
            "usuario-acesso",
            "reconectar-canal-qr",
            "campanhas",
            "permissoes-departamentos",
            "arquivos",
            "crm"
          ]
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "real",
            "treino"
          ]
        },
        "initialStepId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "steps": {
          "minItems": 1,
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stepId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "actionId": {
                "type": "string",
                "enum": [
                  "importar-contatos",
                  "abrir-robos",
                  "abrir-usuarios",
                  "abrir-canais",
                  "abrir-campanhas",
                  "abrir-departamentos",
                  "abrir-atendimento",
                  "abrir-crm"
                ]
              },
              "choices": {
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "nextStepId": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
                    }
                  },
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "stepId",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "guideId",
        "version",
        "mode",
        "initialStepId",
        "steps"
      ],
      "additionalProperties": false
    },
    "AssistantRequestV1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
