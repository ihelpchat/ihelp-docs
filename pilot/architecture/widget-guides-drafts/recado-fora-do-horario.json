    "initialStepId": "abrir-horarios",
    "steps": [
      {
        "stepId": "abrir-horarios",
        "text": "Abra Configurações → Horários e feriados. Se estiver no departamento, clique em Abrir Horários e feriados."
      },
      {
        "stepId": "escolher-abrangencia",
        "text": "Escolha onde mudar o horário. O Horário padrão da empresa vale para todos os departamentos sem exceção. Se só um setor precisa mudar, escolha Só um departamento.",
        "choices": [
          {
            "id": "empresa",
            "label": "Padrão da empresa",
            "nextStepId": "ajustar-padrao"
          },
          {
            "id": "departamento",
            "label": "Só um departamento",
            "nextStepId": "ajustar-excecao"
          },
          {
            "id": "correto",
            "label": "O horário já está correto",
            "nextStepId": "abrir-mensagens"
          }
        ]
      },
      {
        "stepId": "ajustar-padrao",
        "text": "Em Horário padrão da empresa, ajuste Segunda a sexta, Sábado e Domingo. Ative apenas os dias de atendimento. Para mudar só um setor, volte e escolha Só um departamento."
      },
      {
        "stepId": "salvar-padrao",
        "text": "Clique em Salvar na barra de alterações. Aguarde Horário padrão salvo e confira os horários.",
        "choices": [
          {
            "id": "salvo",
            "label": "Conferi o horário",
            "nextStepId": "abrir-mensagens"
          },
          {
            "id": "falhou",
            "label": "Não consegui salvar",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "ajustar-excecao",
        "text": "Em Exceções por departamento, clique em Editar ou Adicionar exceção e escolha o setor. Se aparecer Ainda não há padrão, peça ao responsável para definir o horário da empresa antes de seguir."
      },
      {
        "stepId": "salvar-excecao",
        "text": "Ajuste o horário e a pausa do setor. Confira Sábado e Domingo. Clique em Salvar ou Criar exceção, conforme o botão exibido, e confira o resumo.",
        "choices": [
          {
            "id": "salvo",
            "label": "Conferi a exceção",
            "nextStepId": "abrir-mensagens"
          },
          {
            "id": "falhou",
            "label": "Não consegui configurar",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "abrir-mensagens",
        "text": "Abra Configurações → Mensagens automáticas → Fora de horário."
      },
      {
        "stepId": "selecionar-departamento",
        "text": "Em Departamento, escolha o setor que terá o recado. Confira o nome para não alterar outra equipe."
      },
      {
        "stepId": "escrever-recado",
        "text": "Em Texto da mensagem, escreva quando a equipe volta e confira a prévia. Deixe em branco apenas se esse departamento não deve enviar recado fora do horário."
      },
      {
        "stepId": "salvar-recado",
        "text": "Clique em Salvar na barra de alterações e aguarde Mensagem salva. Se houver erro, anote o aviso para pedir ajuda."
      },
      {
        "stepId": "conferir-recado",
        "text": "Reabra Fora de horário no mesmo Departamento e confira o texto. Confira o horário em Horários e feriados. Se o feriado tiver mensagem própria, ela substitui este recado.",
        "choices": [
          {
            "id": "conferi",
            "label": "Conferi texto e horário"
          },
          {
            "id": "falhou",
            "label": "Não consegui conferir",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "pedir-ajuda",
        "text": "Fale com uma pessoa do atendimento e diga em qual tela e passo parou. Não envie senhas, dados de clientes nem conteúdo de conversas."
      }
    ]
  },
