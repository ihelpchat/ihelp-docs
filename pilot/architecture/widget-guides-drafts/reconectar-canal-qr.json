    "steps": [
      {
        "stepId": "abrir-canais",
        "text": "Abra Configurações e depois Canais. Aqui você reconecta um canal que já existe; o botão Conectar canal da lista serve para pedir um canal novo.",
        "actionId": "abrir-canais"
      },
      {
        "stepId": "abrir-canal-existente",
        "text": "Na lista, abra o canal que aparece como Desconectado. Confira o nome e o número antes de continuar. Não desconecte um canal que está funcionando."
      },
      {
        "stepId": "conferir-tipo",
        "text": "No detalhe, confira o tipo logo abaixo do nome do canal. Este guia vale para WhatsApp · QR code. A API Oficial tem outro processo de conexão: escolha É API Oficial para falar com uma pessoa.",
        "choices": [
          {
            "id": "qr-code",
            "label": "É QR code",
            "nextStepId": "gerar-codigo"
          },
          {
            "id": "oficial",
            "label": "É API Oficial",
            "nextStepId": "pedir-ajuda"
          },
          {
            "id": "conectado",
            "label": "Já está conectado",
            "nextStepId": "conferir-conexao"
          }
        ]
      },
      {
        "stepId": "gerar-codigo",
        "text": "No detalhe do canal, clique em Conectar. No modal Conectar canal, se aparecer Trazer conversas dos últimos dias, marque só se faltar conversa no iHelp. Clique em Gerar QR Code e aguarde o código aparecer.",
        "choices": [
          {
            "id": "apareceu",
            "label": "O QR apareceu",
            "nextStepId": "conferir-celular"
          },
          {
            "id": "falhou",
            "label": "Não apareceu",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "conferir-celular",
        "text": "Para ler o código, você precisa do celular com o WhatsApp deste número e do código aberto na tela do iHelp. O celular está com você?",
        "choices": [
          {
            "id": "disponivel",
            "label": "Estou com o celular",
            "nextStepId": "ler-codigo"
          },
          {
            "id": "ausente",
            "label": "Estou sem o celular",
            "nextStepId": "sem-celular"
          }
        ]
      },
      {
        "stepId": "ler-codigo",
        "text": "No modal, escolha Android ou iPhone e siga os passos mostrados até Dispositivos conectados e Conectar dispositivo. Aponte a câmera do celular para o código na tela do iHelp. Não envie o código pelo chat nem para outras pessoas."
      },
      {
        "stepId": "conferir-conexao",
        "text": "No detalhe do mesmo canal, confira se aparece Conectado. Com o modal ainda aberto, ele mostra Conectado! e Canal conectado. Se continuar Desconectado, escolha Preciso de outro QR ou Preciso de ajuda.",
        "choices": [
          {
            "id": "conectou",
            "label": "Está conectado"
          },
          {
            "id": "novo-codigo",
            "label": "Preciso de outro QR",
            "nextStepId": "gerar-outro-codigo"
          },
          {
            "id": "falhou",
            "label": "Preciso de ajuda",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "gerar-outro-codigo",
        "text": "Clique em Gerar novo código no modal, leia o novo código pelo WhatsApp e confira de novo se o canal aparece como Conectado.",
        "choices": [
          {
            "id": "conectou",
            "label": "Agora está conectado"
          },
          {
            "id": "falhou",
            "label": "Ainda não conectou",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "sem-celular",
        "text": "Sem o celular deste número não dá para ler o código. Seu progresso fica guardado: quando estiver com ele, retome o guia. Se precisar, fale com uma pessoa do atendimento."
      },
      {
        "stepId": "pedir-ajuda",
        "text": "Fale com uma pessoa do atendimento e diga qual canal e em que passo parou. Não envie o QR code, o código de conexão, senhas nem conteúdo de conversas."
      }
    ]
  },
