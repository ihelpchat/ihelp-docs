    "steps": [
      {
        "stepId": "abrir-atendimento",
        "text": "Em Atendimento, abra a conversa do contato que você quer transferir. Confira o nome e o número.",
        "choices": [
          {
            "id": "seguir",
            "label": "Continuar",
            "nextStepId": "abrir-transferencia"
          },
          {
            "id": "bloqueado",
            "label": "Não encontrei / está bloqueado",
            "nextStepId": "pedir-ajuda"
          },
          {
            "id": "pausar",
            "label": "Continuar depois",
            "nextStepId": "pausar"
          }
        ]
      },
      {
        "stepId": "abrir-transferencia",
        "text": "Nas ações da conversa, clique em Transferir. Com a barra lateral recolhida, o botão se chama Transferir atendimento.",
        "choices": [
          {
            "id": "seguir",
            "label": "Continuar",
            "nextStepId": "escolher-departamento"
          },
          {
            "id": "bloqueado",
            "label": "Não encontrei / está bloqueado",
            "nextStepId": "pedir-ajuda"
          },
          {
            "id": "pausar",
            "label": "Continuar depois",
            "nextStepId": "pausar"
          }
        ]
      },
      {
        "stepId": "escolher-departamento",
        "text": "Em Departamento, escolha a equipe que vai receber o atendimento.",
        "choices": [
          {
            "id": "seguir",
            "label": "Continuar",
            "nextStepId": "escolher-pessoa"
          },
          {
            "id": "bloqueado",
            "label": "Não encontrei / está bloqueado",
            "nextStepId": "pedir-ajuda"
          },
          {
            "id": "pausar",
            "label": "Continuar depois",
            "nextStepId": "pausar"
          }
        ]
      },
      {
        "stepId": "escolher-pessoa",
        "text": "Em Usuário (opcional), escolha a pessoa. Para deixar o atendimento com a equipe, mantenha Qualquer usuário do departamento.",
        "choices": [
          {
            "id": "seguir",
            "label": "Continuar",
            "nextStepId": "anotar-contexto"
          },
          {
            "id": "bloqueado",
            "label": "Não encontrei / está bloqueado",
            "nextStepId": "pedir-ajuda"
          },
          {
            "id": "pausar",
            "label": "Continuar depois",
            "nextStepId": "pausar"
          }
        ]
      },
      {
        "stepId": "anotar-contexto",
        "text": "Se precisar, preencha Observação para o próximo atendente com o que a pessoa precisa saber para continuar.",
        "choices": [
          {
            "id": "seguir",
            "label": "Continuar",
            "nextStepId": "confirmar-transferencia"
          },
          {
            "id": "bloqueado",
            "label": "Não encontrei / está bloqueado",
            "nextStepId": "pedir-ajuda"
          },
          {
            "id": "pausar",
            "label": "Continuar depois",
            "nextStepId": "pausar"
          }
        ]
      },
      {
        "stepId": "confirmar-transferencia",
        "text": "Confira o destino e Enviar mensagem de transferência: marcada, a opção envia uma mensagem ao cliente. Clique em Transferir e aguarde o resultado.",
        "choices": [
          {
            "id": "seguir",
            "label": "Continuar",
            "nextStepId": "conferir-resultado"
          },
          {
            "id": "bloqueado",
            "label": "Não encontrei / está bloqueado",
            "nextStepId": "pedir-ajuda"
          },
          {
            "id": "pausar",
            "label": "Continuar depois",
            "nextStepId": "pausar"
          }
        ]
      },
      {
        "stepId": "conferir-resultado",
        "text": "Confira se o departamento e, quando escolhido, o atendente mudaram para o destino esperado. Se não conseguir conferir, peça ajuda.",
        "choices": [
          {
            "id": "conferi",
            "label": "Conferi o resultado"
          },
          {
            "id": "falhou",
            "label": "Não consegui conferir",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "pedir-ajuda",
        "text": "Fale com uma pessoa do atendimento e diga em qual passo parou. Não envie senhas nem conteúdo de conversas."
      },
      {
        "stepId": "pausar",
        "text": "Retome o guia quando puder continuar. Se abriu um formulário sem salvar, clique em Cancelar antes de sair."
      }
    ]
  },
