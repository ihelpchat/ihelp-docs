  "guide": {
    "schemaVersion": 1,
    "guideId": "usuario-acesso",
    "version": 2,
    "mode": "treino",
    "initialStepId": "abrir-usuarios",
    "steps": [
      {
        "stepId": "abrir-usuarios",
        "text": "Abra Configurações e depois Usuários. Se a seção estiver indisponível, peça ao responsável para verificar seu acesso à Equipe.",
        "actionId": "abrir-usuarios"
      },
      {
        "stepId": "criar-usuario",
        "text": "Clique em Novo usuário para abrir o formulário. Se o botão estiver bloqueado, confirme a permissão e o limite de usuários do plano.",
        "choices": [
          {
            "id": "abriu",
            "label": "O formulário abriu",
            "nextStepId": "preencher-dados"
          },
          {
            "id": "bloqueado",
            "label": "Está bloqueado",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "preencher-dados",
        "text": "No formulário Novo usuário, preencha Nome e E-mail. Defina Senha e Confirmar senha no próprio iHelp. Não envie senha pelo chat. A criação atual usa esse e-mail e essa senha; ela não promete enviar convite por e-mail."
      },
      {
        "stepId": "escolher-perfil",
        "text": "No cartão Acesso, escolha o Perfil adequado entre os perfis da empresa. Se o cartão não aparecer ou ficar em Usar tipo de conta legado, revise Tipo de conta e as opções disponíveis; não escolha acesso de administrador apenas para liberar o cadastro."
      },
      {
        "stepId": "escolher-departamento",
        "text": "No cartão Atendimento, em Departamentos, selecione os setores em que a pessoa deve trabalhar. Pelo menos um departamento é obrigatório. A seleção do setor sozinha não comprova isolamento de todos os dados."
      },
      {
        "stepId": "salvar-usuario",
        "text": "Confira os dados e clique em Criar usuário no cabeçalho. Aguarde a confirmação. O iHelp abre o detalhe da pessoa criada, ou a lista se a resposta não trouxer o detalhe.",
        "choices": [
          {
            "id": "criado",
            "label": "A pessoa foi criada",
            "nextStepId": "revisar-acesso"
          },
          {
            "id": "falhou",
            "label": "Não consegui criar",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "revisar-acesso",
        "text": "Se a criação voltou à lista, abra a pessoa que acabou de criar. No detalhe, revise o cartão Acesso. Perfil define o pacote de permissões; uma troca de Perfil é aplicada na hora. Em Exceções desta pessoa, use Ajustar apenas para uma diferença necessária e confirme em Salvar exceções. Não amplie permissões por tentativa."
      },
      {
        "stepId": "conferir-acesso",
        "text": "Peça à pessoa para entrar pelo fluxo de acesso combinado com a empresa e conferir menu e atendimentos esperados. Não compartilhe a senha neste chat. Se houver acesso inesperado, pare e peça revisão ao responsável.",
        "choices": [
          {
            "id": "conferiu",
            "label": "O acesso está correto"
          },
          {
            "id": "incorreto",
            "label": "Há acesso inesperado",
            "nextStepId": "pedir-ajuda"
          }
        ]
      },
      {
        "stepId": "pedir-ajuda",
        "text": "Fale com uma pessoa do atendimento. Informe a opção bloqueada ou o acesso inesperado, sem enviar senha ou dados de clientes."
      }
    ]
  },
